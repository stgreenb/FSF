          {
           "level": 7,
           "features": [
            {
             "id": "domain-death-7",
             "name": "Word of Death Deferred",
             "description": "\nYou can stop death from taking your allies. When an ally within distance of your Healing Grace ability dies and you are not dying, you can use a free triggered action to instead have that ally fall unconscious until they regain Stamina.\n\nAdditionally, your abilities deal an extra 5 damage to winded creatures.",
             "type": "Text",
             "data": null
            }
           ]
          },
          {
           "level": 8,

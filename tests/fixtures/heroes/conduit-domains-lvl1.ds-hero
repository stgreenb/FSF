      }
     },
     {
      "id": "conduit-10-3",
      "name": "Divine Power",
      "description": "\nYou can spend divine power on your abilities as if it were piety.\n\nAdditionally, you can spend divine power as if it were piety to use any conduit abilities you don\u2019t have, as the gods answer your prayers with temporary and unique gifts. If you use a conduit ability you don\u2019t have that usually costs no piety, you must spend 1 divine power to use it.\n\nDivine power remains until you spend it.",
      "type": "Heroic Resource",
      "data": {
       "type": "epic",
       "gains": [
        {
         "tag": "",
         "trigger": "Finish a respite",
         "value": "XP gained"
        }
       ],
       "details": "",
       "canBeNegative": false,
       "value": 0
      }
     },

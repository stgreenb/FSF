    "minLevel": 1,
    "sections": [
     {
      "type": "roll",
      "roll": {
       "characteristic": [
        "Reason"
       ],
       "bonus": 0,
       "tier1": "6 damage; push 4 M < [weak] push is vertical",
       "tier2": "10 damage; push 5 M < [average] push is vertical",
       "tier3": "14 damage; push 6 M < [strong] push is vertical",
       "crit": ""
      }
     },
     {
      "type": "text",
      "text": "\nYou can use this ability as if in the space of one of your minions within your Summoner\u2019s Range.\n\nYou can change the damage type to be a type that your champion deals on their stat block. For each enemy reduced to 0 Stamina by this ability, an ally within distance can move up to their speed."
     }
    ],

{
 "name": "Summoner Test Hero",
 "level": 1,
 "ancestry": {
  "id": "ancestry-anthousai",
  "name": "Anthousai",
  "description": "\n*By Joel Russ*\n\nWhether they came from primal green energies on borders of the wodes, or from the very dreams of Apothachron, Anthousai dazzle the eye and captivate the soul. A riot of color and flower with vaguely humanoid shape, they may have flowers sprouting all over their body and limbs, or even have petals framing their face, and leaves or grasping tendrils for fingers.\n\nSwift to bloom and swift to wither, Anthousai remind others of the fleeting nature of life, and prompt them to make the most of their time upon Orden. Most Anthousai appear untroubled by this bittersweet impression, being too occupied with the moment they are in to mourn times yet to pass.",
  "features": [
   {
    "id": "anthousai-feature-1",
    "name": "Delicate Grace",
    "description": "Delicate Grace, Damage Modifier",
    "type": "Multiple Features",
    "data": {
     "features": [
      {
       "id": "anthousai-feature-1a",
       "name": "Delicate Grace",
       "description": "Your petals and leaves give you substantial surface area compared to your weight. Whenever you fall, you reduce the distance of the fall by 2 squares.",
       "type": "Text",
       "data": null
      },
      {
       "id": "anthousai-feature-1b",
       "name": "Damage Modifier",
       "description": "Fire Weakness + 5, Cold Weakness + 5",
       "type": "Damage Modifier",
       "data": {
        "modifiers": [
         {
          "damageType": "Fire",
